{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/akademie",
      "destination": "/akademien",
      "permanent": true
    },
    {
      "source": "/inhalte",
      "destination": "/kurse/sportphysiotherapie-neu-gedacht",
      "permanent": true
    },
    {
      "source": "/inhalt",
      "destination": "/kurse/sportphysiotherapie-neu-gedacht",
      "permanent": true
    },
    {
      "source": "/kursinhalte",
      "destination": "/kurse/sportphysiotherapie-neu-gedacht",
      "permanent": true
    },
    {
      "source": "/kurs",
      "destination": "/kurse",
      "permanent": true
    },
    {
      "source": "/referenten",
      "destination": "/referent",
      "permanent": true
    },
    {
      "source": "/thorsten-buescher",
      "destination": "/referent",
      "permanent": true
    },
    {
      "source": "/kontakt",
      "destination": "/#kontakt",
      "permanent": true
    },
    {
      "source": "/stimmen",
      "destination": "/#stimmen",
      "permanent": true
    },
    {
      "source": "/kinesio-taping",
      "destination": "/kurse/kinesio-taping",
      "permanent": true
    },
    {
      "source": "/taping",
      "destination": "/kurse/kinesio-taping",
      "permanent": true
    },
    {
      "source": "/pinofit",
      "destination": "/kurse/bandagen-flossing-bfr",
      "permanent": true
    },
    {
      "source": "/bfr",
      "destination": "/kurse/bandagen-flossing-bfr",
      "permanent": true
    },
    {
      "source": "/flossing",
      "destination": "/kurse/bandagen-flossing-bfr",
      "permanent": true
    },
    {
      "source": "/sportphysiotherapie",
      "destination": "/kurse/sportphysiotherapie-neu-gedacht",
      "permanent": true
    }
  ]
}
